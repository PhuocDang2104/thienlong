# Copy to .env at repository root. Replace every CHANGE_ME before production.
APP_ENV=production
POSTGRES_DB=thienlong
POSTGRES_USER=thienlong
# Use generated URL-safe passwords (no URL escaping needed).
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://thienlong:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/thienlong
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=https://thienlong-ten.vercel.app
PUBLIC_FRONTEND_URL=https://thienlong-ten.vercel.app
# The existing network attached to minute_caddy; inspect before setting.
CADDY_NETWORK=CHANGE_ME_EXISTING_CADDY_NETWORK
# Trust forwarded headers only from the actual Caddy IP or its dedicated subnet.
FORWARDED_ALLOW_IPS=CHANGE_ME_CADDY_IP_OR_CIDR

# Used by explicit seed command; changes require seed --update-config.
EVENT_NAME="45 năm Hành Trình - Viết triệu tương lai"
EVENT_START_AT=2026-11-20T17:30:00+07:00
EVENT_VENUE="Gem Center - Sảnh Pollux, Tầng 3"
EVENT_COUNTERS=COUNTER_01,COUNTER_02,COUNTER_03
EVENT_MAX_COMPANIONS=3
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_LONG_ADMIN_PASSWORD
PG_ACCESS_CODE=thienlong-pg
WELCOME_SCREEN_TOKEN=CHANGE_ME_RANDOM_SCREEN_TOKEN
